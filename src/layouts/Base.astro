---
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../data/site.js';
import { fonts, UNICODE_RANGE } from '../data/fonts.js';
import { BASE, withBase } from '../lib/base.js';

const fontFaces = fonts
  .map(
    ({ family, file, weight }) => `@font-face{font-family:'${family}';src:url('${withBase(
      `/fonts/${file}`,
    )}') format('woff2');font-weight:${weight};font-style:normal;font-display:swap;unicode-range:${UNICODE_RANGE}}`,
  )
  .join('');

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
// Kanonická URL musí odpovídat tomu, kam se web reálně deployuje — Vercel do
// rootu domény, GitHub Pages do /<repo>/. Obojí přijde z astro.config (site +
// base), fallback je Vercel doména ze site.js.
// `${BASE}/` — bez koncového lomítka by new URL() poslední segment zahodilo.
const canonical = new URL(`${BASE}/`, Astro.site ?? site.url).href;
const ogImage = new URL('og-image.png', canonical).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: site.name,
  description: site.descriptionLong,
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: site.repos.blender,
  programmingLanguage: ['Python', 'JavaScript'],
  author: site.author.split(', ').map((name) => ({ '@type': 'Person', name })),
  applicationCategory: 'IndustrialVisualInspection',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08080c" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {
      fonts
        .filter((f) => f.preload)
        .map((f) => (
          <link rel="preload" href={withBase(`/fonts/${f.file}`)} as="font" type="font/woff2" crossorigin />
        ))
    }
    <style is:inline set:html={fontFaces}></style>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="grain-overlay" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/scroll-setup.js';
    </script>
  </body>
</html>
