---
import Picture from './Picture.astro';

/* Díl je v Blender passech obyčejný obdélník ve stejném místě kádru (crop
   660×825, viz build-assets.mjs). V % rámu stage: x 18.64–81.21, y 12.12–87.88.
   Světelný pass se na tenhle obdélník clipuje, aby screen blend nerozsvítil
   i pozadí komory. */
const PART_INSET = 'inset(12.12% 18.79% 12.12% 18.64%)';

const cadSteps = [
  ['01', 'CAD geometry'],
  ['02', 'Material assignment'],
  ['03', 'PBR textures'],
  ['04', 'Physical lighting'],
  ['05', 'Rendered frame'],
];
---

<section id="data-gap" class="data-gap section" aria-labelledby="data-gap-heading" data-data-gap>
  <div class="container">
    <h2 id="data-gap-heading" data-reveal>The data gap</h2>

    <article class="gap-block gap-block--1" data-reveal-group>
      <div class="gap-block__text" data-reveal>
        <h3>Real defects are rare</h3>
        <p>In quality manufacturing, defects occur in single-digit percentages. To train an AI model to detect a fingerprint on a metal part, you need hundreds to thousands of defective samples. Producing them on purpose is expensive and does not scale.</p>
      </div>
      <div class="gap-block__visual" data-reveal>
        <div class="gap-parts">
          <figure class="gap-part">
            <Picture
              slug="part-clean"
              alt="Machined metal part, clean surface"
              loading="lazy"
              inspectable
              label="Cls_Obj_Front_Side"
              confidence={99.15}
              box="23,13,57,69"
            />
            <figcaption class="mono"><i class="gap-part__dot" aria-hidden="true"></i>clean</figcaption>
          </figure>
          <figure class="gap-part gap-part--defect">
            <Picture
              slug="part-defected"
              alt="The same part with fingerprint residue on the upper face"
              loading="lazy"
              inspectable
              label="Cls_Obj_Front_Side"
              confidence={93.15}
              box="23,13,57,69"
              defectLabel="Cls_Defect_Fingerprint"
              defectConfidence={92.93}
              defects="24.3,12.9,20.6,31.4;56.9,23.2,14.4,18.5"
            />
            <figcaption class="mono"><i class="gap-part__dot" aria-hidden="true"></i>defected</figcaption>
          </figure>
        </div>
      </div>

      <div
        class="ratio-bar"
        data-ratio-bar
        data-reveal
        role="img"
        aria-label="One defective part for every 130 clean parts in series production."
      >
        <div class="ratio-bar__head" aria-hidden="true">
          <span class="ratio-bar__count mono"><span data-ratio-count>000</span> clean</span>
          <span class="ratio-bar__flag mono" data-ratio-flag>1 defect</span>
        </div>
        <div class="ratio-bar__track" aria-hidden="true">
          <div class="ratio-bar__ticks"></div>
          <div class="ratio-bar__fill"></div>
          <div class="ratio-bar__scan"></div>
          <div class="ratio-bar__defect">
            <span class="ratio-bar__defect-glow"></span>
          </div>
        </div>
        <span class="ratio-bar__sub mono" aria-hidden="true">1 : 130 — measured defect rate, series production</span>
      </div>
    </article>

    <article class="gap-block gap-block--2" data-reveal-group data-cad-track>
      <div class="gap-block__sticky">
      <div class="gap-block__text" data-reveal>
        <h3>The product may not exist yet</h3>
        <p>What if you want the inspection system ready before production even starts? Before the first batch? For a part that exists only as a CAD model?</p>
      </div>

      <div class="gap-cad" data-cad>
        <ol class="cad-steps mono" data-cad-steps>
          <li class="cad-steps__rail" aria-hidden="true"></li>
          {cadSteps.map(([idx, label], i) => (
            <li class:list={['cad-step', { 'is-active': i === cadSteps.length - 1, 'is-past': i < cadSteps.length - 1 }]} data-phase={i}>
              <span class="cad-step__idx">{idx}</span>
              <span class="cad-step__label">{label}</span>
            </li>
          ))}
        </ol>

        <div class="cad-stage viewfinder" data-cad-stage style={`--part-inset:${PART_INSET}`}>
          {/* Vrstvy zdola nahoru: solid → pbr → light (screen) → render → wire.
              Světelný pass i finální render sdílí JEDNU masku: světelný pruh je
              přesně ta hrana, za kterou už je díl vyrenderovaný. Světlo tedy
              render „namaluje", nepřekrývá ho. */}
          <div class="cad-layer cad-layer--solid" data-cad-solid aria-hidden="true">
            <Picture slug="cad-solid" alt="" loading="lazy" />
          </div>

          <div class="cad-layer cad-layer--pbr" data-cad-pbr aria-hidden="true">
            <Picture slug="cad-pbr" alt="" loading="lazy" />
          </div>

          <div class="cad-layer cad-layer--light" data-cad-light aria-hidden="true">
            <Picture slug="cad-light" alt="" loading="lazy" />
          </div>

          <div class="cad-layer cad-layer--render" data-cad-render>
            <Picture
              slug="cad-render"
              alt="The part as a physically rendered frame — the same geometry Blender built from the CAD model"
              loading="lazy"
            />
          </div>

          <svg
            class="cad-layer cad-layer--wire"
            data-cad-wire
            viewBox="0 0 100 125"
            aria-hidden="true"
            fill="none"
          >
            <defs>
              <pattern id="dg-cad-grid" width="5" height="5" patternUnits="userSpaceOnUse">
                <path d="M5 0H0V5" stroke="var(--accent)" stroke-width="0.15" opacity="0.35" />
              </pattern>
            </defs>

            <g data-cad-grid>
              <rect width="100" height="125" fill="url(#dg-cad-grid)" />
              <line x1="18.6" y1="116" x2="81.2" y2="116" stroke="var(--text-muted)" stroke-width="0.2" />
              <text x="18.6" y="120.5" font-size="2.6" fill="var(--text-muted)" letter-spacing="0.2">SYNTH_EYE / PART_A · REV 02</text>
            </g>

            {/* Geometrie odečtená z cad-solid (viz build-assets.mjs): obdélník
                18.64–81.21 × 15.15–109.85, díry na x 42.05 v y 42.95 a 82.05,
                bore r 4.62, zahloubení r 9.47. */}
            <g stroke="var(--accent)" stroke-width="1" vector-effect="non-scaling-stroke">
              <path d="M18.64 15.15 H81.21 V109.85 H18.64 Z" />
              <circle cx="42.05" cy="42.95" r="9.47" stroke-width="0.7" vector-effect="non-scaling-stroke" />
              <circle cx="42.05" cy="42.95" r="4.62" />
              <circle cx="42.05" cy="82.05" r="9.47" stroke-width="0.7" vector-effect="non-scaling-stroke" />
              <circle cx="42.05" cy="82.05" r="4.62" />
            </g>

            <g stroke="var(--accent-light)" stroke-width="0.2" opacity="0.55">
              <path d="M30.6 42.95 H53.5 M42.05 31.5 V54.4" />
              <path d="M30.6 82.05 H53.5 M42.05 70.6 V93.5" />
            </g>

            <g stroke="var(--text-secondary)" stroke-width="0.2" opacity="0.8">
              <path d="M18.64 15.15 H8 M18.64 109.85 H8" />
              <path d="M10 15.15 V109.85" />
              <path d="M18.64 15.15 V7 M81.21 15.15 V7" />
              <path d="M18.64 9 H81.21" />
              <path d="M45.3 39.7 L86 30" />
            </g>

            <g fill="var(--text-secondary)" font-size="3.2">
              <text x="7.2" y="62.5" transform="rotate(-90 7.2 62.5)" text-anchor="middle">60.00</text>
              <text x="49.9" y="6.4" text-anchor="middle">40.00</text>
              <text x="87" y="28.8">⌀6.00</text>
            </g>
          </svg>

          <p class="cad-hud mono" data-cad-hud aria-hidden="true">cycles · 128 spp · 1024²</p>
        </div>
      </div>
      </div>
    </article>

    <article class="gap-block gap-block--3" data-reveal-group>
      <div class="gap-block__text" data-reveal>
        <h3>Manual annotation is the bottleneck</h3>
        <p>Every image needs a bounding box, a label, a quality check. That is hours of manual work. Synth.Eye generates the data and the annotations automatically.</p>
      </div>
      <div class="gap-block__stats" data-reveal>
        <div class="stat">
          <span class="stat__num mono" data-counter="6000" data-decimals="0">6,000</span>
          <span class="stat__label mono">images</span>
        </div>
        <div class="stat stat--hero viewfinder">
          <span class="stat__glow" aria-hidden="true"></span>
          <span class="stat__num mono" data-zero-lock>0</span>
          <span class="stat__label mono">manual labels</span>
        </div>
        <div class="stat">
          <span class="stat__num mono" data-reveal-text>&lt; 1 hr</span>
          <span class="stat__label mono">generation time</span>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  import { whenVisible } from '../scripts/lib/lazy-init.js';
  whenVisible('[data-data-gap]', () => import('../scripts/data-gap.js'));
</script>

<style>
  .data-gap { background: var(--bg-primary); }
  .data-gap h2 { margin-bottom: var(--space-9); }
  .gap-block {
    display: grid;
    gap: var(--space-7);
  }
  /* Pacing: rozestupy se ke třetímu bloku zkracují — čtení zrychluje
     směrem k pointě (0 manual labels). */
  .gap-block--1 { margin-bottom: var(--space-12); }
  .gap-block--2 { margin-bottom: var(--space-11); }
  .gap-block h3 { font-size: var(--fs-h3); margin-bottom: var(--space-4); }

  /* ── Blok 1: text v úzké koloně, pár dílů široký, poměrový bar se láme
     přes celou šířku bloku — vodorovná linka je ta pointa (1 : 130). */
  .gap-block--1 {
    grid-template-columns: 0.85fr 1.35fr;
    grid-template-areas: 'text visual' 'bar bar';
    align-items: end;
    row-gap: var(--space-8);
  }
  .gap-block--1 .gap-block__text { grid-area: text; }
  .gap-block--1 .gap-block__visual { grid-area: visual; }
  .gap-block--1 .ratio-bar { grid-area: bar; }

  .gap-parts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .gap-part { position: relative; margin: 0; }
  .gap-part :global(.picture-wrap) { border: 1px solid var(--border); }
  .gap-part--defect :global(.picture-wrap) {
    border-color: color-mix(in srgb, var(--nok) 32%, transparent);
  }
  .gap-part figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 11px;
    color: var(--text-muted);
    margin-top: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .gap-part__dot {
    display: block;
    width: 5px;
    height: 5px;
    flex: none;
    background: var(--ok);
    box-shadow: 0 0 0 3px var(--ok-glow);
  }
  .gap-part--defect figcaption { color: color-mix(in srgb, var(--nok) 70%, var(--text-muted)); }
  .gap-part--defect .gap-part__dot { background: var(--nok); box-shadow: 0 0 0 3px var(--nok-glow); }

  /* ── Poměrový bar */
  .ratio-bar__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }
  .ratio-bar__count { font-size: var(--fs-mono-md); color: var(--text-primary); }
  .ratio-bar__flag {
    font-size: var(--fs-mono-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--nok);
    opacity: 0;
    transform: translateY(4px);
  }
  .ratio-bar__track {
    position: relative;
    height: 8px;
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
  }
  /* Značky každých 10 dílů — dávají baru měřítko, bez nich je to jen pruh. */
  .ratio-bar__ticks {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      90deg,
      var(--border-hover) 0 1px,
      transparent 1px calc(100% / 13)
    );
  }
  .ratio-bar__fill { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--ok); }
  /* Scan head — čte se jako inspekční hlava projíždějící sérii. */
  .ratio-bar__scan {
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: 0;
    width: 1px;
    background: var(--text-primary);
    box-shadow: 0 0 10px 2px var(--accent-glow);
    opacity: 0;
  }
  /* Poměr 1 : 130 → jediný defekt je 1/131 šířky baru. Segment je záměrně
     nepatrný; glow ho udrží čitelný, aniž by lhal o proporci. */
  .ratio-bar__defect {
    position: absolute;
    right: 0;
    top: 0;
    width: max(3px, 0.76%);
    height: 100%;
    background: var(--nok);
    opacity: 0;
    transform: scaleX(0.2);
    transform-origin: right center;
  }
  .ratio-bar__defect-glow {
    position: absolute;
    inset: -10px -14px;
    background: radial-gradient(ellipse at center, var(--nok-glow), transparent 70%);
    opacity: 0;
  }
  .ratio-bar__sub {
    font-size: 11px;
    color: var(--text-muted);
    display: block;
    margin-top: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Blok 2: CAD → render ────────────────────────────────────────────────
     Sekvence má pět fází. V běžném toku jí zbývala ~jedna obrazovka scrollu
     na všech pět a dojezd (05 Rendered frame + HUD) dosedal až ve chvíli, kdy
     vizuál odjížděl z viewportu — v klidové zóně obrazovky tak uživatel viděl
     vždycky jen rozpracovanou fázi. Blok proto dostane vlastní scroll track
     a stage se v něm sticky-drží celou obrazovku.
     Sticky, ne ScrollTrigger `pin` — ze stejného důvodu jako v
     PipelineTransition.astro (scroll řídí Lenis, pin-spacer by skákal).
     Pin režim zapíná JS atributem data-cad-mode, takže bez JS i v
     prefers-reduced-motion zůstává obyčejný tok bez 220vh prázdna. */
  .gap-block--2 { display: block; }
  .gap-block__sticky {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }
  .gap-block--2 .gap-block__text { max-width: 52ch; }

  /* Pin travel: 220vh track − 100svh sticky okno = 120vh čistého scrollu na
     pět fází (≈24vh na fázi) + hold na konci, viz SEQ_END v data-gap.js. */
  .gap-block--2[data-cad-mode='pinned'] { min-height: 220vh; }
  .gap-block--2[data-cad-mode='pinned'] .gap-block__sticky {
    position: sticky;
    top: 0;
    min-height: 100svh;
    align-content: center;
  }

  .gap-cad {
    /* Šířku stage limituje i výška okna — v sticky režimu musí stage plus
       text zůstat v jedné obrazovce. Poměr passů je 660/825 = 0.8. */
    --cad-stage-w: min(340px, 46svh);
    display: grid;
    grid-template-columns: auto var(--cad-stage-w);
    gap: var(--space-6);
    align-items: center;
    justify-content: center;
  }
  .cad-steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    --cad-progress: 1;
  }
  .cad-steps__rail { position: absolute; inset: 0; pointer-events: none; }
  .cad-steps::before,
  .cad-steps__rail::after {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 1px;
  }
  .cad-steps::before { background: var(--border-hover); }
  .cad-steps__rail::after {
    background: var(--accent);
    transform: scaleY(var(--cad-progress));
    transform-origin: top center;
  }
  .cad-step {
    position: relative;
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: 11px;
    color: var(--text-muted);
    /* Nesplněné kroky jdou pod text-muted, jinak je rozdíl „ještě přijde"
       vs. „už proběhlo" na 11px monospace nečitelný a rail zůstává jediný
       nosič progressu. */
    opacity: 0.5;
    transition:
      color var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }
  .cad-step__idx { color: inherit; opacity: 0.6; }
  .cad-step.is-past { color: var(--text-secondary); opacity: 1; }
  .cad-step.is-active { color: var(--accent); opacity: 1; }
  .cad-step.is-active .cad-step__idx { opacity: 1; }

  /* Značka na railu — dává progressu diskrétní zastávky, aby bylo poznat,
     kolik fází ještě zbývá. Rail leží na levé hraně padding-boxu <ol>,
     tj. −space-5 od obsahu kroku; −2px centruje 5px puntík na 1px lince. */
  .cad-step::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-5) - 2px);
    top: 0.35em;
    width: 5px;
    height: 5px;
    background: var(--bg-primary);
    box-shadow: inset 0 0 0 1px var(--border-hover);
  }
  .cad-step.is-past::before {
    background: var(--accent);
    box-shadow: none;
    opacity: 0.5;
  }
  .cad-step.is-active::before {
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .cad-stage {
    position: relative;
    aspect-ratio: 660 / 825; /* = crop Blender passů, viz build-assets.mjs */
    width: var(--cad-stage-w);
    max-width: 100%;
    background: var(--bg-deep);
    /* Bez isolate by screen blend světelného passu prosákl na pozadí sekce
       místo aby se složil jen v rámci stage. */
    isolation: isolate;
  }
  .cad-layer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cad-layer :global(.picture-wrap) { width: 100%; height: 100%; background: none; }
  .cad-layer :global(.picture-img) { width: 100%; height: 100%; object-fit: cover; }

  /* CSS default = HOTOVÝ stav (stejná konvence jako reveal.js, které animuje
     gsap.from). Bez JS tedy sekce ukáže finální render, ne rozpracovaný
     wireframe. Startovní stav si nastaví data-gap.js sám (armCad). */
  .cad-layer--solid { opacity: 0; will-change: opacity; }
  .cad-layer--pbr { opacity: 1; will-change: opacity; }
  .cad-layer--wire { opacity: 0; will-change: opacity; }

  /* Světelný pass (anizotropní specular, černá s bílými čarami) se přičítá
     přes screen — proto clip na obdélník dílu, jinak by prosvítilo i stěnu
     komory v pozadí. Maska propouští jen úzký pruh, který jezdí napříč:
     to je ten „osvit". */
  /* Maska je 3× širší než element. mask-position P % dává offset −2W·P/100,
     takže maska pokrývá element jen pro P ∈ [0, 100] — mimo ten rozsah by
     nezamaskovaná část zmizela. Hrana wipu proto musí ležet mezi 33,3 % a
     66,7 % masky; 47–53 % má rezervu na obě strany a zároveň to je přesně
     jádro světelného pruhu níž. */
  .cad-layer--light {
    clip-path: var(--part-inset);
    mix-blend-mode: screen;
    opacity: 0;
    --wipe: 100%;
    -webkit-mask-image: linear-gradient(100deg, transparent 41%, #000 47%, #000 53%, transparent 59%);
    mask-image: linear-gradient(100deg, transparent 41%, #000 47%, #000 53%, transparent 59%);
    -webkit-mask-size: 300% 100%;
    mask-size: 300% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: var(--wipe) 0;
    mask-position: var(--wipe) 0;
    will-change: mask-position, opacity;
  }

  /* Finální render odkrývá TÁŽ maska, jen jako plný wipe místo pruhu —
     světelný pruh a hrana odkrytí tak sedí na sobě (oba 47–53 % masky). */
  .cad-layer--render {
    --wipe: 0%;
    -webkit-mask-image: linear-gradient(100deg, #000 0 47%, transparent 53% 100%);
    mask-image: linear-gradient(100deg, #000 0 47%, transparent 53% 100%);
    -webkit-mask-size: 300% 100%;
    mask-size: 300% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: var(--wipe) 0;
    mask-position: var(--wipe) 0;
    will-change: mask-position;
  }

  .cad-layer--wire text { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .cad-hud {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  /* ── Blok 3: countery */
  .gap-block--3 { grid-template-columns: 1fr 1fr; align-items: center; }
  .gap-block__stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: var(--space-6);
    justify-content: start;
    align-items: end;
    text-align: left;
    overflow-x: clip;
  }
  .stat__num { display: block; font-size: var(--fs-mono-lg); color: var(--text-primary); }
  .stat--hero { position: relative; padding: var(--space-4) var(--space-5); }
  .stat--hero .stat__num {
    position: relative;
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    line-height: 0.9;
    color: var(--accent);
  }
  /* Glow jako radiální světlo, ne zaoblený vyplněný box. */
  .stat__glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 42% 45%, var(--accent-glow), transparent 65%);
    opacity: 0;
    pointer-events: none;
  }
  .stat__label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: var(--space-3);
    display: block;
  }
  .stat--hero .stat__label { position: relative; color: var(--text-secondary); }
  .rt-char { display: inline-block; }

  @media (max-width: 1024px) {
    .gap-cad {
      --cad-stage-w: min(280px, 42svh);
      grid-template-columns: 1fr;
      gap: var(--space-5);
      justify-content: start;
