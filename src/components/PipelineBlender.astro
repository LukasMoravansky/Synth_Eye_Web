---
import Picture from './Picture.astro';

/* Real vs. rendered — srovnání vedle sebe, identita napsaná od začátku.

   Dřív to byl kvíz („hádej, který je render"). Nefunkční: každý snímek je jiný
   vzorek — reálná kontaminace je na horní ploše, procedurální na dolní — takže
   divák nepoznával render, poznával „jinou fotku". Důkaz tvrzení z citace nad
   prvkem („indistinguishable from reality") proto nenese oko diváka, ale
   shodné skóre detektoru vypsané pod oběma snímky.

   Ze stejného důvodu je nelze překrývat: wipe mezi dvěma neregistrovanými
   vzorky se čte jako chyba registrace, ne jako přechod render → realita.

   Oba snímky jsou cropnuté stejným cropem 700×900 (viz build-assets.mjs),
   takže díl v nich zabírá stejný podíl kádru — bez toho by se rozdíl čet jako
   „jeden je blíž".

   Reálná strana je vlevo: čtení „realita → simulace" je přirozené a maskovat
   render už není proč. */

// TODO: reálné hodnoty z inference nad real_before.png / render_after.png.
// Jeden zdroj pravdy pro statický readout i hover overlay — nesmí se rozejít.
const DETECTION_CLASS = 'Cls_Obj_Front_Side';
const CONFIDENCE = { real: 99.02, synthetic: 98.94 };

const CARDS = [
  {
    slug: 'compare-real',
    kind: 'real',
    title: 'Real capture',
    meta: 'Basler acA1920-40uc · 16 mm · f/4.0',
    confidence: CONFIDENCE.real,
    alt: 'Machined metal part with fingerprint contamination on the upper face, seen from the inspection camera angle',
  },
  {
    slug: 'compare-render',
    kind: 'synthetic',
    title: 'Blender render',
    meta: 'Cycles · 512 spp · procedural fingerprint',
    confidence: CONFIDENCE.synthetic,
    alt: 'Machined metal part with fingerprint contamination on the lower face, seen from the inspection camera angle',
  },
];

/* Co je na obou stranách shodné — tvrzení „jedna komora, dva výstupy". */
const SHARED = ['same lens', 'same lighting', 'same material', 'same crop'];
---

<section id="blender" class="pipeline-blender section" aria-labelledby="blender-heading">
  <div class="container">
    <h2 id="blender-heading" data-reveal>First principles: physical simulation</h2>

    <div class="blender-grid">
      <div class="blender-scheme viewfinder" data-reveal-group>
        <Picture slug="scheme-hw" alt="Hardware virtualization scheme" loading="lazy" class="blender-scheme__img" />
        <ul class="blender-annotations mono" aria-hidden="true">
          <li><span>camera</span> Basler acA1920-40uc</li>
          <li><span>lens</span> 16 mm · f/4.0</li>
          <li><span>lighting</span> diffuse dome + directional</li>
          <li><span>material</span> PBR · brushed aluminium</li>
          <li><span>renderer</span> Cycles · 512 samples</li>
        </ul>
      </div>

      <div class="blender-output" data-reveal>
        <Picture slug="pbr-render" alt="PBR render output" loading="lazy" inspectable label="Cls_Obj_Front_Side" confidence={99.15} />
        <blockquote class="blender-quote">
          We virtualize the entire inspection chamber — camera, lens, lighting, materials.
          Physical rendering in Blender produces images indistinguishable from reality.
        </blockquote>
      </div>
    </div>

    <div class="ab" data-blender-bridge data-reveal-group>
      <ol class="ab-pair">
        {CARDS.map(({ slug, kind, title, meta, confidence, alt }) => (
          <li class:list={['ab-card', `ab-card--${kind}`]} data-reveal>
            <div class="ab-card__frame viewfinder">
              <Picture
                slug={slug}
                alt={alt}
                loading="lazy"
                sizes="(max-width: 768px) 44vw, 22vw"
                inspectable
                label={DETECTION_CLASS}
                confidence={confidence}
              />
              <p class="ab-card__origin mono">
                <b>{title}</b><span>{meta}</span>
              </p>
            </div>
            {/* Skóre staticky, ne jen v hover overlayi: caption tvrdí, že detektor
                oba snímky skóruje stejně — to musí být vidět bez interakce.
                Pro odečítač je to duplikát (je v aria-label snímku), proto skryté. */}
            <p class="ab-card__score mono" aria-hidden="true">
              <span>{DETECTION_CLASS}</span><b>{confidence.toFixed(2)}%</b>
            </p>
          </li>
        ))}

        <li class="ab-bridge" aria-hidden="true" data-reveal>
          <svg class="ab-bridge__rule" viewBox="0 0 1 100" preserveAspectRatio="none" focusable="false">
            <line x1="0.5" y1="0" x2="0.5" y2="100" vector-effect="non-scaling-stroke" />
          </svg>
          <p class="ab-bridge__specs mono">{SHARED.join(' · ')}</p>
        </li>
      </ol>

      {/* Tentýž výpis vodorovně — pod ~1024px se do výšky kádru vertikálně
          nevejde, ale zmizet nesmí, nese tvrzení „jedna komora". */}
      <p class="ab-shared mono" aria-hidden="true" data-reveal>{SHARED.join(' · ')}</p>

      <p class="ab-caption mono" data-reveal>
        Left: inspection camera. Right: Blender. Same lens, same lighting, same material —
        and the detector scores them the same.
      </p>
    </div>
  </div>
</section>

<script>
  import { whenVisible } from '../scripts/lib/lazy-init.js';
  whenVisible('[data-blender-bridge]', () => import('../scripts/blender-bridge.js'));
</script>

<style>
  .pipeline-blender { background: var(--bg-elevated); }
  .pipeline-blender h2 { margin-bottom: var(--space-8); }
  /* fr, ne %: 45%+55%+gap = 100% + gap → horizontální overflow celé stránky */
  .blender-grid { display: grid; grid-template-columns: 45fr 55fr; gap: var(--space-7); margin-bottom: var(--space-10); }
  .blender-scheme { background: var(--bg-surface); border: 1px solid var(--border); padding: var(--space-5); position: relative; }
  .blender-annotations { list-style: none; margin-top: var(--space-4); font-size: 11px; color: var(--text-muted); }
  .blender-annotations li { margin-bottom: var(--space-2); }
  .blender-annotations span { color: var(--text-secondary); margin-right: var(--space-2); }
  .blender-quote { margin-top: var(--space-5); font-size: 1.1rem; color: var(--text-secondary); border-left: 2px solid var(--accent); padding-left: var(--space-5); font-style: italic; }
  /* ── Real vs. rendered ───────────────────────────────────────────────────
     Dvě stejně velké karty s permanentní identitou, mezi nimi bridge se
     shodnými parametry. Rám drží nativní poměr sdíleného cropu (700×900),
     takže díl vyplňuje kádr a obě strany mají shodné měřítko. */
  .ab { max-width: 820px; margin-inline: auto; }
  .ab-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-5);
    align-items: start;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ab-card { margin: 0; }
  /* Bridge je v DOM poslední (karty jdou z jednoho map()), do prostředního
     sloupce ho staví order — ne grid-column, aby mobilní 1fr 1fr fallback
     nemusel nic přepisovat. */
  .ab-bridge { order: 1; }
  .ab-card:nth-child(2) { order: 2; }
  /* Rohové značky viewfinderu drží rám snímku, ne kartu — na kartě by spodní
     značka visela pod rezervovaným místem pro popisek, odtržená od obrazu.
     Žádné overflow: hidden není potřeba, snímek klipuje .picture-wrap. */
  .ab-card__frame {
    position: relative;
    aspect-ratio: 700 / 900; /* = sdílený crop, viz build-assets.mjs */
    background: var(--bg-deep);
    border: 1px solid var(--border);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .ab-card :global(.picture-wrap) { width: 100%; height: 100%; background: none; }
  .ab-card :global(.picture-img) { width: 100%; height: 100%; object-fit: cover; }
  .ab-card:hover .ab-card__frame,
  .ab-card:focus-within .ab-card__frame { border-color: var(--border-hover); }

  /* Identita jako overlay v kádru, ne popisek pod ním — první, co oko na
     snímku najde, musí být „co to je", ne odkaz na interakci. */
  .ab-card__origin {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    /* Šířka podle textu, ne přes celý kádr — pruh přes celou šířku zakrývá díl. */
    width: max-content;
    max-width: calc(100% - 2 * var(--space-3));
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 6px 10px;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    background: rgba(8, 8, 12, 0.72);
    border: 1px solid var(--border-hover);
  }
  .ab-card__origin b {
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  /* Accent = vygenerované. Jediné barevné odlišení v prvku, takže nese celý
     rozdíl mezi oběma stranami. */
  .ab-card--synthetic .ab-card__origin b { color: var(--accent-light); }

  /* Readout drží formát hover chipu z inspection-cursor.js (`label conf%`) —
     dvě čtení téhož čísla se nesmí lišit sazbou. */
  .ab-card__score {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .ab-card__score b {
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }
  .ab-card--synthetic .ab-card__score b { color: var(--accent-light); }

  /* ── Spec bridge ─────────────────────────────────────────────────────────
     Vertikální linka mezi kádry se seznamem toho, co je shodné. Tvrdí „jedna
     komora, dva výstupy" — bez ní by srovnání vypadalo jako dvě nesouvisející
     fotky. */
  .ab-bridge {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
  }
  .ab-bridge__rule {
    width: 1px;
    height: 100%;
    flex: none;
    overflow: visible;
  }
  /* Výchozí stav je dokreslená linka, ne prázdná: bez JS (nebo při reduced
     motion) musí být vidět. Skrytí a dokreslení si dělá blender-bridge.js. */
  .ab-bridge__rule line {
    stroke: var(--border-hover);
    stroke-width: 1;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .ab-bridge__specs {
    margin: 0;
    writing-mode: vertical-rl;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }
  /* Vodorovná varianta výpisu — jen tam, kde bridge text nezobrazuje. */
  .ab-shared {
    display: none;
    margin: var(--space-4) 0 0;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ab-caption {
    max-width: 60ch;
    margin: var(--space-5) 0 0;
    font-size: var(--fs-mono-sm);
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Kádr je tady vysoký ~420 px, vertikální výpis potřebuje ~460 px → přeteče
     mimo obraz. Linka zůstává, text se přesouvá pod pár. */
  @media (max-width: 1023px) {
    .ab-bridge__specs { display: none; }
    .ab-shared { display: block; }
  }

  @media (max-width: 768px) {
    .blender-grid { grid-template-columns: 1fr; }
    /* Vedle sebe zůstává i na mobilu — srovnání je celý smysl prvku. Bridge
       ale ne: vertikální text mezi kádry sežere šířku, kterou potřebuje obraz. */
    .ab-pair { grid-template-columns: 1fr 1fr; gap: var(--space-3); }
    .ab-bridge { display: none; }
    .ab-card__origin { padding: 4px 6px; font-size: 9px; }
    .ab-card__score { flex-direction: column; gap: 2px; }
  }
</style>
