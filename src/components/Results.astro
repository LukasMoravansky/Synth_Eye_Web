---
import Picture from './Picture.astro';

/* Evidence matice 3×2. Sloupec = třída dílu, řada = origin dat. Pointa sekce je
 * SLOUPCOVÁ dvojice: nahoře snímek, na kterém se model učil, pod ním reálný
 * snímek téže třídy s tím, co model predikoval. Dvě nezávislé galerie (původní
 * verze) tuhle vazbu nenesly.
 *
 * Rozdíl obou řad není jen původ snímku, ale i POVAHA anotace:
 *   SYNTHETIC — box je ground truth. Compositor ví, kam otisk položil, label
 *               vzniká zadarmo. Confidence u něj nemá význam, proto tam žádná
 *               není (badge `LABEL`, ne verdikt).
 *   REAL      — box je predikce modelu, tedy má confidence i verdikt OK/NOK.
 *
 * Souřadnice boxů jsou v % rozměru snímku a jsou NAMĚŘENÉ, ne odhadnuté:
 *   gan-front / gan-composite / gan-back (340² cropy z GAN_output.png)
 *     — prahování jasu > 60 na hotovém assetu; u gan-composite navíc segmentace
 *       hnědého residua (r > 95, r−b > 40, r−g > 14) + spojité komponenty:
 *       jediná skupina 1203 px, což je ten otisk vlevo nahoře.
 *   evid-front / evid-defect / evid-back (800² cropy reálných snímků)
 *     — bbox z `outline` ve src/scripts/data/gui-demo-frames.js (min/max čtyř
 *       rohů v nativním kádru 1920×1200) minus offset cropu, děleno 800.
 *       Defekty tamtéž z `defects`. Confidence rovněž odtud — jsou to čísla
 *       z logu reálné inspekce, ne dopsaná.
 * Kdo změní crop v build-assets.mjs, MUSÍ přepočítat i tyhle boxy.
 */
const OBJ_FRONT = 'Cls_Obj_Front_Side';
const OBJ_BACK = 'Cls_Obj_Back_Side';
const DEFECT = 'Cls_Defect_Fingerprint';

const pairs = [
  {
    category: 'front side',
    synth: {
      slug: 'gan-front',
      alt: 'Synthetic training sample — front side of the part, generated by the GAN pipeline',
      cls: OBJ_FRONT,
      box: '17.1,6.5,65.6,87.4',
    },
    real: {
      slug: 'evid-front',
      alt: 'Real production image — front side of the part, classified OK',
      cls: OBJ_FRONT,
      box: '6.2,10.6,87.5,78.8',
      confidence: 96.02,
      verdict: 'OK',
    },
  },
  {
    category: 'front + fingerprint',
    synth: {
      slug: 'gan-composite',
      alt: 'Synthetic training sample — front side with a composited fingerprint residue',
      cls: DEFECT,
      box: '20.9,6.5,57.9,87.4',
      defects: '25.6,6.8,13.2,19.1',
    },
    real: {
      slug: 'evid-defect',
      alt: 'Real production image — front side with fingerprint contamination, classified NOK',
      cls: DEFECT,
      box: '11.0,7.0,77.9,85.9',
      defects: '34.1,12.9,21.9,30.0;57.9,27.9,20.0,21.2',
      objCls: OBJ_FRONT,
      objConfidence: 95.08,
      confidence: 93.74,
      verdict: 'NOK',
    },
  },
  {
    category: 'back side',
    synth: {
      slug: 'gan-back',
      alt: 'Synthetic training sample — back side of the part, generated by the GAN pipeline',
      cls: OBJ_BACK,
      box: '12.9,7.1,75.0,85.9',
    },
    real: {
      slug: 'evid-back',
      alt: 'Real production image — back side of the part, classified OK',
      cls: OBJ_BACK,
      box: '13.4,6.5,73.2,86.9',
      confidence: 94.31,
      verdict: 'OK',
    },
  },
];

/** "l,t,w,h;l,t,w,h" → [[l,t,w,h], …]. Statický overlay čte TOTÉŽ co data-* pro
 *  inspection cursor, aby se obě vykreslení nemohla rozejít. */
const boxes = (value) =>
  (value || '')
    .split(';')
    .filter(Boolean)
    .map((g) => g.split(',').map(Number));
---

<section id="results" class="results section" aria-labelledby="results-heading">
  <div class="container">
    <h2 id="results-heading" data-reveal>Trained on synthetic. Proven on real.</h2>

    <dl class="results-metrics" data-reveal-group>
      <div class="metric metric--primary">
        <dt><span aria-hidden="true">&gt;</span><span data-counter="99" data-decimals="0" aria-label="Greater than 99 percent">99</span><span aria-hidden="true">%</span></dt>
        <dd><span>object classification</span><span>on real images</span></dd>
      </div>
      <div class="metric">
        <dt><span aria-hidden="true">&gt;</span><span data-counter="95" data-decimals="0" aria-label="Greater than 95 percent">95</span><span aria-hidden="true">%</span></dt>
        <dd><span>defect detection</span><span>on real images</span></dd>
      </div>
      <div class="metric metric--offset">
        <dt><span data-counter="6000" data-decimals="0" aria-label="6000">6,000</span></dt>
        <dd><span>synthetic images</span><span>zero manual labels</span></dd>
      </div>
    </dl>

    <div class="evidence">
      <!-- Reveal staggeruje jen dlaždice; osy matice (labely origin i tříd) jsou
           vidět od začátku, jinak by pár na chvíli neměl co pojmenovat. -->
      <div class="matrix" data-reveal-group data-reveal-stagger="0.09">
        <p class="matrix__origin matrix__origin--synth mono" aria-hidden="true">
          SYNTHETIC<span class="matrix__origin-sub">(train)</span>
          <span class="matrix__flow">↓</span>
        </p>
        <p class="matrix__origin matrix__origin--real mono" aria-hidden="true">
          REAL<span class="matrix__origin-sub">(test)</span>
        </p>

        {pairs.map((pair, i) => (
          <>
            <h3 class="pair__cat mono" style={`--col:${i + 2}`}>{pair.category}</h3>

            <figure class="tile tile--synth viewfinder" style={`--col:${i + 2}`} data-reveal>
              <div class="tile__frame">
                <Picture slug={pair.synth.slug} alt={pair.synth.alt} loading="lazy" inspectable label={pair.synth.cls} box={pair.synth.box} defects={pair.synth.defects} />
                <svg class="tile__boxes tile__boxes--gt" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  {boxes(pair.synth.box).map(([l, t, w, h]) => (
                    <rect x={l} y={t} width={w} height={h} class="bx bx--obj" />
                  ))}
                  {boxes(pair.synth.defects).map(([l, t, w, h]) => (
                    <rect x={l} y={t} width={w} height={h} class="bx bx--defect" />
                  ))}
                </svg>
              </div>
              <figcaption class="tile__cap mono">
                <span class="sr-only">Synthetic training sample, {pair.category}. Ground-truth label, no prediction: </span>
                <span class="tile__origin" aria-hidden="true">train</span>
                <span class="tag tag--gt">LABEL</span>
                <span class="tile__cls">{pair.synth.cls}</span>
              </figcaption>
            </figure>

            <figure class="tile tile--real viewfinder" style={`--col:${i + 2}`} data-reveal>
              <div class="tile__frame">
                <Picture
                  slug={pair.real.slug}
                  alt={pair.real.alt}
                  loading="lazy"
                  inspectable
                  label={pair.real.objCls ?? pair.real.cls}
                  confidence={pair.real.objConfidence ?? pair.real.confidence}
                  box={pair.real.box}
                  defects={pair.real.defects}
                  defectLabel={pair.real.defects ? pair.real.cls : undefined}
                  defectConfidence={pair.real.defects ? pair.real.confidence : undefined}
                />
                <svg class="tile__boxes" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  {boxes(pair.real.box).map(([l, t, w, h]) => (
                    <rect x={l} y={t} width={w} height={h} class="bx bx--obj" />
                  ))}
                  {boxes(pair.real.defects).map(([l, t, w, h]) => (
                    <rect x={l} y={t} width={w} height={h} class="bx bx--defect" />
                  ))}
                </svg>
              </div>
              <figcaption class="tile__cap mono">
                <span class="sr-only">Real production image, {pair.category}. Model prediction: </span>
                <span class="tile__origin" aria-hidden="true">test</span>
                <span class={`tag tag--${pair.real.verdict.toLowerCase()}`}>{pair.real.verdict}</span>
                <span class="tile__cls">{pair.real.cls}</span>
                <span class="tile__conf">{pair.real.confidence}%</span>
              </figcaption>
            </figure>
          </>
        ))}
      </div>

      <p class="evidence__note" data-reveal>Trained entirely on synthetic data. Tested on real production images from the factory floor. No real images were labeled during training.</p>
    </div>
  </div>
</section>

<style>
  .results { background: var(--bg-deep); }
  .results h2 { margin-bottom: var(--space-10); }
  .results-metrics { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: var(--space-6); margin-bottom: var(--space-11); }
  .metric dt { font-family: var(--font-mono); font-size: clamp(3rem, 8vw, 7rem); font-weight: 500; font-variant-numeric: tabular-nums; color: var(--text-primary); line-height: 1; }
  .metric--primary dt { font-size: clamp(3.5rem, 9vw, 7.5rem); }
  .metric--offset { transform: translateY(var(--space-6)); }
  .metric dd { margin-top: var(--space-4); }
  .metric dd span { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
  .metric dd span:first-child { color: var(--text-secondary); }
  .metric dd span:last-child { color: var(--text-muted); }
  /* Matice: gutter s labely origin + 3 sloupce tříd. Pozice jsou EXPLICITNÍ
     (grid-row podle třídy prvku, grid-column přes inline --col), ne auto-flow —
     s auto-placementem by první label sklouzl do prázdné buňky gutteru. */
  .matrix {
    display: grid;
    grid-template-columns: 7.5rem repeat(3, minmax(0, 1fr));
    column-gap: var(--space-5);
    row-gap: var(--space-3);
    align-items: start;
  }
  .matrix__origin {
    grid-column: 1;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding-top: var(--space-2);
  }
  .matrix__origin--synth { grid-row: 2; }
  .matrix__origin--real { grid-row: 3; }
  .matrix__origin-sub { display: block; color: var(--text-muted); }
  /* Šipka drží tvrzení sekce: tenhle sloupec se učil nahoře a testoval dole. */
  .matrix__flow { display: block; margin-top: var(--space-4); font-size: 15px; line-height: 1; color: var(--text-muted); }
  .pair__cat {
    grid-row: 1;
    grid-column: var(--col);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .tile {
    grid-column: var(--col);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: var(--space-3);
  }
  .tile--synth { grid-row: 2; }
  .tile--real { grid-row: 3; }
  /* Kvadratický kádr: oba assety jsou 1:1 (340² GAN / 900² crop), takže se
     obrázek do rámu vejde beze zbytku a % souřadnice boxů = % rámu. */
  .tile__frame { position: relative; aspect-ratio: 1; overflow: hidden; }
  .tile__frame :global(.picture-wrap) { height: 100%; }
  .tile__frame :global(.picture-img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Statický overlay kreslí TYTÉŽ souřadnice, které dostane inspection cursor;
     hover jen přidá mono chip s labelem. Proto se nic nepřekresluje jinam. */
  .tile__boxes { position: absolute; inset: 0; pointer-events: none; }
  .bx { fill: none; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .bx--obj { stroke: var(--accent); }
  .bx--defect { stroke: var(--nok); }
  /* Ground truth se od predikce liší i tvarem linky, ne jen barvou. */
  .tile__boxes--gt .bx { stroke-dasharray: 4 3; opacity: 0.75; }
  .tile__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: 10px;
    color: var(--text-muted);
    margin-top: var(--space-3);
  }
  .tile__cls { color: var(--text-secondary); }
  .tile__conf { color: var(--text-muted); }
  .tile__origin { display: none; }
  .tag { font-weight: 700; letter-spacing: 0.04em; }
  .tag--gt { color: var(--text-muted); }
  .tag--ok { color: var(--ok); }
  .tag--nok { color: var(--nok); }
  .evidence__note { color: var(--text-secondary); max-width: 60ch; margin-top: var(--space-8); }

  @media (max-width: 768px) {
    .results-metrics { grid-template-columns: 1fr; }
    .metric--offset { transform: none; }
    /* Gutter zmizí, ale pár musí zůstat pár: dvě kolony = train vlevo, test
       vpravo, label třídy nad nimi přes celou šířku. Origin se stěhuje do
       captionu každé dlaždice, protože ho už nenese osa gridu. */
    .matrix { grid-template-columns: 1fr 1fr; row-gap: var(--space-3); }
    .matrix__origin { display: none; }
    .pair__cat, .tile { grid-row: auto; grid-column: auto; }
    .pair__cat { grid-column: 1 / -1; margin-top: var(--space-6); }
    .pair__cat:first-of-type { margin-top: 0; }
    .tile__origin { display: inline; color: var(--text-muted); opacity: 0.7; }
  }
  @media (max-width: 480px) {
    /* Dlaždice s boxy musí zůstat čitelná — radši jedna kolona než dvě miniatury. */
    .matrix { grid-template-columns: 1fr; }
    .tile__cap { font-size: 9px; }
  }
</style>
