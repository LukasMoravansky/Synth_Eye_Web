---
/* Minimal fixed nav — A0 stub, styled for dark theme */
import { withBase } from '../lib/base.js';
---

<nav class="nav" id="site-nav" aria-label="Site navigation">
  <div class="nav__inner container">
    <a href="#hero" class="nav__logo" aria-label="Synth.Eye home">
      <img src={withBase('/images/logo-light.svg')} alt="" width="120" height="32" />
    </a>
    <div class="nav__links">
      <a href="https://github.com/rparak/Synth_Eye" target="_blank" rel="noopener noreferrer">
        GitHub<span class="sr-only"> (opens in new tab)</span>
      </a>
      <a href="https://huggingface.co/LukasMoravansky/Synth-Eye-GAN" target="_blank" rel="noopener noreferrer">
        HuggingFace<span class="sr-only"> (opens in new tab)</span>
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  if (nav) {
    const onScroll = () => nav.classList.toggle('nav--scrolled', window.scrollY > 100);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    padding-block: var(--space-4);
    transition: background var(--dur-base) var(--ease-out), backdrop-filter var(--dur-base);
  }
  .nav--scrolled {
    /* Higher opacity + smaller blur radius than the original 12px: the nav
       spans the full viewport width, so on 4K displays backdrop-filter has to
       re-sample far more pixels every scroll frame. A stronger solid tint
       keeps the frosted look readable with a much cheaper blur. */
    background: rgba(8, 8, 12, 0.85);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav__logo img {
    height: 28px;
    width: auto;
  }
  .nav__links {
    display: flex;
    gap: var(--space-5);
  }
  .nav__links a {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
  }
  .nav__links a:hover {
    color: var(--accent-light);
  }

  /* Nav byl jediná sekce úplně bez mobilního ošetření. Dva problémy naráz:
       – terč: 12px mono řádek je 17px vysoký, tedy pod polovinou doporučeného
         minima. Padding ho zvětší na 44 px, aniž by se posunula sazba.
       – šířka: logo (105px) + GITHUB + HUGGINGFACE + tracking 0.1em vychází
         na ~303px, takže na 320px viewportu odkaz přetéká pod grain overlay.
     padding-block var(--space-2) + 44px terč drží celkovou výšku navu na 60 px,
     s jakou počítá `padding-block` v Hero.astro. */
  @media (max-width: 700px) {
    .nav {
      padding-block: var(--space-2);
    }
    .nav__logo img {
      height: 24px;
    }
    .nav__links {
      gap: 0;
    }
    .nav__links a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding-inline: var(--space-3);
      letter-spacing: 0.06em;
    }
    /* Poslední odkaz zůstává zarovnaný na gutter, ne odsazený od něj. */
    .nav__links a:last-child {
      padding-right: 0;
    }
  }

  @media (max-width: 400px) {
    .nav__links a {
      font-size: 10px;
      letter-spacing: 0.03em;
      padding-inline: var(--space-2);
    }
  }
</style>
