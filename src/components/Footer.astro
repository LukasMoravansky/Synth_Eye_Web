---
/* Footer — team + institutions */
import { withBase } from '../lib/base.js';
/* LinkedIn URL s diakritikou v slugu MUSÍ být percent-encoded — nekódované
   `á`/`š`/`ý` v href projde v prohlížeči, ale rozbije se při kopírování a v HTML
   validaci. Lukáš = luk%C3%A1%C5%A1-moravansk%C3%BD, Filip = filip-rusn%C3%A1k. */
const contributors = [
  { initials: 'RP', name: 'Roman Parak', url: 'https://www.linkedin.com/in/roman-parak/' },
  { initials: 'LM', name: 'Lukas Moravansky', url: 'https://www.linkedin.com/in/luk%C3%A1%C5%A1-moravansk%C3%BD-6102ba1b0' },
  { initials: 'FR', name: 'Filip Rusnak', url: 'https://www.linkedin.com/in/filip-rusn%C3%A1k-93b789325/' },
];
---

<footer class="footer" id="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src={withBase('/images/logo.svg')} alt="" width="100" height="28" />
      <p class="footer__claim">Train on synthetic. Deploy on real.</p>
      <p class="footer__copy mono">© 2026 Synth.Eye · MIT License</p>
    </div>

    <nav class="footer__col" aria-label="Contributors">
      <h2 class="footer__heading mono">Contributors</h2>
      <ul class="footer__people">
        {contributors.map((c) => (
          <li>
            {/* Celý řádek je terč, ne jen jméno — avatar 44px je největší část
                odkazu a klik na něj musí fungovat stejně jako na text. */}
            <a href={c.url} target="_blank" rel="noopener noreferrer">
              <span class="footer__avatar mono" aria-hidden="true">{c.initials}</span>
              <span>{c.name}</span>
              <span class="sr-only"> — LinkedIn (opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Repositories">
      <h2 class="footer__heading mono">Repositories</h2>
      <ul class="footer__links mono">
        <li><a href="https://github.com/rparak/Synth_Eye" target="_blank" rel="noopener noreferrer">Synth_Eye<span class="sr-only"> (opens in new tab)</span></a></li>
        <li><a href="https://github.com/LukasMoravansky/Synth_Eye_GAN" target="_blank" rel="noopener noreferrer">Synth_Eye_GAN<span class="sr-only"> (opens in new tab)</span></a></li>
        <li><a href="https://github.com/LukasMoravansky/stylegan2-ada-pytorch" target="_blank" rel="noopener noreferrer">stylegan2-ada-pytorch<span class="sr-only"> (opens in new tab)</span></a></li>
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading mono">Institution</h2>
      <p class="footer__institution"><a href="https://www.jic.cz/en/" target="_blank" rel="noopener noreferrer">JIC<span class="sr-only"> (opens in new tab)</span></a></p>
      <span class="footer__badge mono">MIT</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-deep);
    border-top: 1px solid var(--border);
    padding-block: var(--space-10);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }
  .footer__claim { color: var(--text-secondary); margin: var(--space-4) 0; font-size: 0.9rem; }
  .footer__copy { font-size: 11px; color: var(--text-muted); }
  .footer__heading { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-4); }
  .footer__people { list-style: none; }
  .footer__people li { margin-bottom: var(--space-3); }
  .footer__people a {
    display: flex; align-items: center; gap: var(--space-3);
    color: var(--text-secondary);
    transition: color 0.2s;
  }
  .footer__people a:hover { color: var(--text-primary); }
  .footer__avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--bg-surface); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; color: var(--text-secondary);
    transition: border-color 0.2s, color 0.2s;
  }
  .footer__people a:hover .footer__avatar,
  .footer__people a:focus-visible .footer__avatar { border-color: var(--border-hover); color: var(--accent); }
  .footer__links { list-style: none; font-size: 12px; }
  .footer__links a { color: var(--text-secondary); }
  .footer__institution { font-family: var(--font-display); color: var(--text-secondary); margin-bottom: var(--space-2); }
  .footer__badge {
    display: inline-block; margin-top: var(--space-4);
    border: 1px solid var(--border); padding: var(--space-1) var(--space-3);
    font-size: 11px; color: var(--text-muted);
  }
  @media (max-width: 768px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) { .footer__grid { grid-template-columns: 1fr; } }
  /* 12px mono řádek = ~20px terč, a jsou tři pod sebou. inline-block + padding
     dá 40px, aniž by se rozhodila sazba sloupce; `align-items: center` v .footer
     nikde nekoliduje, protože odkazy jsou v <li> na vlastním řádku. */
  @media (pointer: coarse) {
    .footer__links a,
    .footer__institution a {
      display: inline-block;
      padding-block: var(--space-3);
    }
    .footer__links li + li { margin-top: 0; }
  }
</style>
